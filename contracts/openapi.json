{
  "components": {
    "schemas": {
      "AcceptedOutput": {
        "properties": {
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "reading": {
            "$ref": "#/components/schemas/ReadingOutput"
          }
        },
        "required": [
          "outcome",
          "reading"
        ],
        "title": "AcceptedOutput",
        "type": "object"
      },
      "DeliveryOutput": {
        "properties": {
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "receipt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt"
          }
        },
        "required": [
          "outcome",
          "event_id",
          "receipt"
        ],
        "title": "DeliveryOutput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PageOutput": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingOutput"
            },
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "readings",
          "next_cursor"
        ],
        "title": "PageOutput",
        "type": "object"
      },
      "ReadingInput": {
        "additionalProperties": false,
        "examples": [
          {
            "identity": "ridge-001",
            "kelvin": 281.25,
            "station": "North ridge"
          }
        ],
        "properties": {
          "identity": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Identity",
            "type": "string"
          },
          "kelvin": {
            "minimum": 0.0,
            "title": "Kelvin",
            "type": "number"
          },
          "station": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Station",
            "type": "string"
          }
        },
        "required": [
          "identity",
          "station",
          "kelvin"
        ],
        "title": "ReadingInput",
        "type": "object"
      },
      "ReadingOutput": {
        "properties": {
          "observation": {
            "$ref": "#/components/schemas/ReadingInput"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "observation"
        ],
        "title": "ReadingOutput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Study SOLID through durable observations and retry-safe intake. Try requests below. Records are append-only; identities cannot overwrite history. Receipt processing creates local previews.",
    "title": "Field Notebook",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/export": {
      "get": {
        "operationId": "export_export_get",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "title": "Format",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 9223372036854775807,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export",
        "tags": [
          "Exports"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "Operations"
        ]
      }
    },
    "/outbox/process": {
      "post": {
        "description": "Process one pending event using an idempotent local preview sink. Retries reuse its receipt; no email is sent.",
        "operationId": "process_outbox_process_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryOutput"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process",
        "tags": [
          "Receipts"
        ]
      }
    },
    "/readings": {
      "get": {
        "operationId": "list_readings_readings_get",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 9223372036854775807,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Readings",
        "tags": [
          "Readings"
        ]
      },
      "post": {
        "operationId": "record_readings_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Exact idempotent replay"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Identity or key conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Storage acknowledgement unconfirmed"
          }
        },
        "summary": "Record",
        "tags": [
          "Readings"
        ]
      }
    },
    "/readings/{identity}": {
      "get": {
        "operationId": "get_reading_readings__identity__get",
        "parameters": [
          {
            "in": "path",
            "name": "identity",
            "required": true,
            "schema": {
              "title": "Identity",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Reading",
        "tags": [
          "Readings"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "Operations"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ]
}
